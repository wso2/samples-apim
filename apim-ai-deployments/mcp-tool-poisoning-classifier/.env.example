# Copy to .env (which is git-ignored) and generate the key before use:
#   openssl rand -hex 32
# Docker Compose reads .env from this directory; a variable exported in your
# shell takes precedence over the value here.
# Left empty on purpose: a placeholder here is a credential published in this
# repository, and an unedited copy would start the service with it. Compose
# refuses to start while this is empty and names the variable it needs.
TOOL_POISONING_API_KEY=
TOOL_POISONING_MODEL_ID=wso2/tool-poisoning-detection
TOOL_POISONING_MODEL_REVISION=1d62fb57258ee41c3e3ebe8520faad633de12ac2
TOOL_POISONING_DEVICE=cpu
TOOL_POISONING_MAX_ITEMS=32
TOOL_POISONING_MAX_CONCURRENT_REQUESTS=4
TOOL_POISONING_LOG_LEVEL=INFO
