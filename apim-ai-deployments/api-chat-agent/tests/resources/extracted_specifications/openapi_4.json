        {
            "name": "Get Contacts",
            "description": "List, search, and filter contacts",
            "method": "GET",
            "path": "/api/3/contacts",
            "parameters": {
                "ids": {
                    "location": "query",
                    "description": "Filter contacts by ID. Can be repeated for multiple IDs.",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "string"
                    }
                },
                "email": {
                    "location": "query",
                    "description": "Filter contacts by ID. Can be repeated for multiple IDs.",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "string"
                    }
                },
                "email_like": {
                    "location": "query",
                    "description": "Filter contacts that contain the given value in the email address",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "string"
                    }
                },
                "exclude": {
                    "location": "query",
                    "description": "Exclude from the response the contact with the given ID",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "integer"
                    }
                },
                "formid": {
                    "location": "query",
                    "description": "Filter contacts associated with the given form",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "integer"
                    }
                },
                "id_greater": {
                    "location": "query",
                    "description": "Only include contacts with an ID greater than the given ID",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "integer"
                    }
                },
                "id_less": {
                    "location": "query",
                    "description": "Only include contacts with an ID less than the given ID",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "integer"
                    }
                },
                "listid": {
                    "location": "query",
                    "description": "Filter contacts associated with the given list",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "string"
                    }
                },
                "search": {
                    "location": "query",
                    "description": "Filter contacts that match the given value in the contact names, organization, phone or email",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "string"
                    }
                },
                "segmentid": {
                    "location": "query",
                    "description": "Return only contacts that match a list segment (this param initially returns segment information, when it is run a second time it will return contacts that match the segment)",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "integer"
                    }
                },
                "seriesid": {
                    "location": "query",
                    "description": "Filter contacts associated with the given automation",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "integer"
                    }
                },
                "status": {
                    "location": "query",
                    "description": "Status",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "integer"
                    }
                },
                "tagid": {
                    "location": "query",
                    "description": "Filter contacts associated with the given tag",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "integer"
                    }
                },
                "filters[created_before]": {
                    "location": "query",
                    "description": "Filter contacts that were created prior to this date",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "string"
                    }
                },
                "filters[created_after]": {
                    "location": "query",
                    "description": "Filter contacts that were created after this date",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "string"
                    }
                },
                "filters[updated_before]": {
                    "location": "query",
                    "description": "Filter contacts that were updated before this date",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "string"
                    }
                },
                "filters[updated_after]": {
                    "location": "query",
                    "description": "Filter contacts that were updated after this date",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "string"
                    }
                },
                "waitid": {
                    "location": "query",
                    "description": "Filter by contacts in the wait queue of an automation block",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "integer"
                    }
                },
                "orders[cdate]": {
                    "location": "query",
                    "description": "Order contacts by creation date",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "string"
                    }
                },
                "orders[email]": {
                    "location": "query",
                    "description": "Order contacts by email",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "string"
                    }
                },
                "orders[first_name]": {
                    "location": "query",
                    "description": "Order contacts by first name",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "string"
                    }
                },
                "orders[last_name]": {
                    "location": "query",
                    "description": "Order contacts by last name",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "string"
                    }
                },
                "orders[name]": {
                    "location": "query",
                    "description": "Order contacts by full name",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "string"
                    }
                },
                "forders[score]": {
                    "location": "query",
                    "description": "Order contacts by score",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "string"
                    }
                },
                "in_group_lists": {
                    "location": "query",
                    "description": "Set this to \"true\" in order to return only contacts that the current user has permissions to see.",
                    "style": "form",
                    "explode": true,
                    "schema": {
                        "type": "string"
                    }
                }
            }
        },
