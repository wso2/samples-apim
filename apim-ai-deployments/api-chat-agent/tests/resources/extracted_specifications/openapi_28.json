{
    "serviceUrl": "https://{endpoint}/openai",
    "tools": [
        {
            "name": "ChatCompletions_Create",
            "description": "Creates a completion for the chat message",
            "method": "POST",
            "path": "/deployments/{deployment-id}/chat/completions",
            "parameters": {
                "deployment-id": {
                    "location": "path",
                    "required": true,
                    "schema": {
                        "type": "string"
                    }
                },
                "api-version": {
                    "location": "query",
                    "required": true,
                    "schema": {
                        "type": "string"
                    }
                }
            },
            "requestBody": {
                "mediaType": "application/json",
                "schema": {
                    "type": "object",
                    "required": [
                        "messages"
                    ],
                    "properties": {
                        "messages": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": [
                                    "role",
                                    "content"
                                ],
                                "properties": {
                                    "role": {
                                        "type": "string",
                                        "enum": [
                                            "system",
                                            "user",
                                            "assistant"
                                        ]
                                    },
                                    "content": {
                                        "type": "string"
                                    },
                                    "name": {
                                        "type": "string"
                                    }
                                }
                            }
                        },
                        "temperature": {
                            "type": "number"
                        },
                        "top_p": {
                            "type": "number"
                        },
                        "n": {
                            "type": "integer"
                        },
                        "stream": {
                            "type": "boolean"
                        },
                        "stop": {
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            ]
                        },
                        "max_tokens": {
                            "type": "integer"
                        },
                        "presence_penalty": {
                            "type": "number"
                        },
                        "frequency_penalty": {
                            "type": "number"
                        },
                        "logit_bias": {
                            "type": "object",
                            "properties": {}
                        },
                        "user": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    ]
}
