            "description": "Get message history for a channel",
            "method": "GET",
            "path": "/channels/{channel_id}/messages",
            "parameters": {
                "channel_id": {
                    "location": "path",
                    "description": "The [Channel's ID](https://www.ably.io/documentation/rest/channels).",
                    "required": true,
                    "schema": {
                        "type": "string"
                    }
                },
                "start": {
                    "location": "query",
                    "description": "Beginning of time The start of the query interval as a time in milliseconds since the epoch. A message qualifies as a member of the result set if it was received at or after this time.",
                    "schema": {
                        "type": "string"
                    }
                },
                "limit": {
                    "location": "query",
                    "description": "The maximum number of records to return. A limit greater than 1,000 is invalid.",
                    "schema": {
                        "type": "integer"
                    }
                },
                "end": {
                    "location": "query",
                    "description": "The end of the query interval as a time in milliseconds since the epoch. A message qualifies as a member of the result set if it was received at or before this time.",
                    "schema": {
                        "type": "string"
                    }
                },
                "direction": {
                    "location": "query",
                    "description": "The direction of this query. The direction determines the order of the returned result array, but also determines which end of the query interval is the start point for the search. For example, a forwards query uses start as the start point, whereas a backwards query uses end as the start point.",
                    "schema": {
                        "type": "string",
                        "enum": [
                            "forwards",
                            "backwards"
                        ]
                    }
                }
            }
        },
