                                "ACTIVE",
                                "DISABLED"
                            ]
                        },
                        "manager_id": {
                            "type": "string"
                        },
                        "department_id": {
                            "type": "string"
                        },
                        "location_id": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        {
            "name": "listCardsByUserIdGet",
            "description": "Lists all cards by a `user_id`. Only cards with `limit_type = CARD` have `spend_controls`\n",
            "method": "GET",
            "path": "/v2/cards",
            "parameters": {
                "user_id": {
                    "location": "query",
                    "description": "User ID",
                    "required": false,
                    "schema": {
                        "type": "string"
                    }
                },
                "cursor": {
                    "location": "query",
                    "description": "Page cursor",
                    "required": false,
                    "schema": {
                        "type": "string"
                    }
                },
                "limit": {
                    "location": "query",
