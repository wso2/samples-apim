{
    "serviceUrl": "https://platform.staging.brexapps.com",
    "tools": [
        {
            "name": "getUserLimitGet",
            "description": "This endpoint gets the monthly limit for the user including the monthly available limit.\n",
            "method": "GET",
            "path": "/v2/users/{id}/limit",
            "parameters": {
                "id": {
                    "location": "path",
                    "description": "User ID",
                    "required": true,
                    "schema": {
                        "type": "string"
                    }
                }
            }
        },
        {
            "name": "setUserLimitPost",
            "description": "This endpoint sets the monthly limit for a user.  The limit amount must be non-negative.  To unset the monthly limit of the user, just set `monthly_limit` to null.\n",
            "method": "POST",
            "path": "/v2/users/{id}/limit",
            "parameters": {
                "id": {
                    "location": "path",
                    "description": "User ID",
                    "required": true,
                    "schema": {
                        "type": "string"
                    }
                }
            },
            "requestBody": {
                "mediaType": "application/json",
                "schema": {
                    "type": "object",
                    "properties": {
                        "monthly_limit": {
                            "type": "object",
                            "properties": {
                                "amount": {
                                    "type": "integer"
                                },
                                "currency": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        {
