        {
            "name": "getCardByIdGet",
            "description": "Retrieves a card by ID. Only cards with `limit_type = CARD` have `spend_controls`\n",
            "method": "GET",
            "path": "/v2/cards/{id}",
            "parameters": {
                "id": {
                    "location": "path",
                    "description": "Card ID",
                    "required": true,
                    "schema": {
                        "type": "string"
                    }
                }
            }
        },
        {
            "name": "updateCardPut",
            "description": "Update an existing vendor card\n",
            "method": "PUT",
            "path": "/v2/cards/{id}",
            "parameters": {
                "id": {
                    "location": "path",
                    "description": "Card ID",
                    "required": true,
                    "schema": {
                        "type": "string"
                    }
                }
            },
            "requestBody": {
                "mediaType": "application/json",
                "schema": {
                    "type": "object",
                    "properties": {
                        "spend_controls": {
                            "type": "object",
                            "properties": {
                                "spend_limit": {
                                    "type": "object",
                                    "properties": {
                                        "amount": {
                                            "type": "integer"
                                        },
                                        "currency": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "spend_duration": {
                                    "type": "string",
                                    "enum": [
                                        "MONTHLY",
                                        "QUARTERLY",
                                        "YEARLY",
                                        "ONE_TIME"
                                    ]
                                },
                                "lock_after_date": {
                                    "type": "string",
                                    "format": "date",
                                    "pattern": "yyyy-MM-dd"
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "name": "lockCardPost",
            "description": "Locks an existing, unlocked card. And the card owner will receive a notification about it.\n",
            "method": "POST",
            "path": "/v2/cards/{id}/lock",
            "parameters": {
                "id": {
                    "location": "path",
                    "description": "Card ID",
                    "required": true,
                    "schema": {
                        "type": "string"
                    }
                }
            },
            "requestBody": {
                "mediaType": "application/json",
                "schema": {
                    "type": "object",
                    "required": [
                        "reason"
                    ],
                    "properties": {
                        "description": {
                            "type": "string"
                        },
                        "reason": {
                            "type": "string",
                            "enum": [
                                "CARD_DAMAGED",
                                "CARD_LOST",
                                "CARD_NOT_RECEIVED",
                                "DO_NOT_NEED_PHYSICAL_CARD",
                                "DO_NOT_NEED_VIRTUAL_CARD",
                                "FRAUD",
                                "OTHER"
                            ]
                        }
                    }
                }
            }
        },
        {
