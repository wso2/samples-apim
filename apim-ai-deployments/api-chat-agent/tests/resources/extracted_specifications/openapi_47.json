        {
            "name": "createCardPost",
            "description": "Creates a new card. It's strongly recommended that you set an idempotency-key in this request. The `spend_controls` field is required when `limit_type` = `CARD`. The `mailing_address` field is required for physical cards, and the first two lines of the address must be under 60 characters long.\n",
            "method": "POST",
            "path": "/v2/cards",
            "parameters": {},
            "requestBody": {
                "mediaType": "application/json",
                "schema": {
                    "type": "object",
                    "required": [
                        "card_name",
                        "card_type",
                        "limit_type",
                        "owner"
                    ],
                    "properties": {
                        "owner": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "enum": [
                                        "USER"
                                    ]
                                },
                                "user_id": {
                                    "type": "string"
                                }
                            }
                        },
                        "card_name": {
                            "type": "string"
                        },
                        "card_type": {
                            "type": "string",
                            "enum": [
                                "VIRTUAL",
                                "PHYSICAL"
                            ]
                        },
                        "limit_type": {
                            "type": "string",
                            "enum": [
                                "CARD",
                                "USER"
                            ]
                        },
                        "spend_controls": {
                            "type": "object",
                            "required": [
                                "spend_duration",
                                "spend_limit"
                            ],
                            "properties": {
                                "spend_limit": {
                                    "type": "object",
                                    "properties": {
                                        "amount": {
                                            "type": "integer"
                                        },
                                        "currency": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "spend_duration": {
                                    "type": "string",
                                    "enum": [
                                        "MONTHLY",
                                        "QUARTERLY",
                                        "YEARLY",
                                        "ONE_TIME"
                                    ]
                                },
                                "reason": {
                                    "type": "string"
                                },
                                "lock_after_date": {
                                    "type": "string",
                                    "format": "date",
                                    "pattern": "yyyy-MM-dd"
                                }
                            }
                        },
                        "mailing_address": {
                            "type": "object",
                            "properties": {
                                "line1": {
                                    "type": "string"
                                },
                                "line2": {
                                    "type": "string"
                                },
                                "city": {
                                    "type": "string"
                                },
                                "state": {
                                    "type": "string"
                                },
                                "country": {
                                    "type": "string"
                                },
                                "postal_code": {
                                    "type": "string"
                                },
                                "phone_number": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
